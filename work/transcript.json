{
 "model": "large-v3",
 "duration": 59.7681875,
 "segments": [
  {
   "start": 0.0,
   "end": 2.94,
   "text": " Jak w 5 minut zamienić Cloud Code w zespół 6 programistów?"
  },
  {
   "start": 2.98,
   "end": 4.14,
   "text": " Pierwsza wtyczka Super Powers"
  },
  {
   "start": 4.14,
   "end": 6.56,
   "text": " 127 tysięcy gwiazdek na GitHubie"
  },
  {
   "start": 6.56,
   "end": 8.66,
   "text": " Cloud przestaje od razu zrzucać się na pisanie kodu"
  },
  {
   "start": 8.66,
   "end": 11.6,
   "text": " Zaczyna planować, pisać teksty i sprawdzać własną pracę"
  },
  {
   "start": 11.6,
   "end": 12.98,
   "text": " Druga wtyczka, może już tobie znana"
  },
  {
   "start": 12.98,
   "end": 13.82,
   "text": " Frontend Design"
  },
  {
   "start": 13.82,
   "end": 16.24,
   "text": " 277 tysięcy gwiazdek na GitHubie"
  },
  {
   "start": 16.24,
   "end": 17.28,
   "text": " Stworzona przez Antropik"
  },
  {
   "start": 17.28,
   "end": 19.06,
   "text": " Eliminuje typowy wygląd stron przez AI"
  },
  {
   "start": 19.06,
   "end": 21.56,
   "text": " Tworzy profesjonalne interfejsy gotowe do wdrożenia"
  },
  {
   "start": 21.56,
   "end": 22.64,
   "text": " Trzecia Code Review"
  },
  {
   "start": 22.64,
   "end": 24.34,
   "text": " 5 agentów pracuje równolegle"
  },
  {
   "start": 24.34,
   "end": 26.08,
   "text": " Każdy sprawdza twój kod z innej strony"
  },
  {
   "start": 26.08,
   "end": 27.46,
   "text": " Błędy w kodzie, historia zmienia"
  },
  {
   "start": 27.46,
   "end": 28.24,
   "text": " Wszystko na raz"
  },
  {
   "start": 28.24,
   "end": 29.5,
   "text": " Czwarta Security Review"
  },
  {
   "start": 29.5,
   "end": 34.48,
   "text": " Przeszukuje cały twój kod, tak aby nikt nie skracił kluczy w API i abyś był bezpieczny zanim cokolwiek opublikuje"
  },
  {
   "start": 34.48,
   "end": 35.52,
   "text": " Piąta, najlepsza"
  },
  {
   "start": 35.52,
   "end": 36.88,
   "text": " Zaraz ci powiem, ale najpierw"
  },
  {
   "start": 36.88,
   "end": 39.68,
   "text": " Jeśli chcesz pełną, dokładną analizę twojego całego profilu"
  },
  {
   "start": 39.68,
   "end": 42.86,
   "text": " Chcesz wiedzieć co cię blokuje i chcesz gotowe, wiralowe filmiki do nagrywania"
  },
  {
   "start": 42.86,
   "end": 43.84,
   "text": " Zupełnie za darmo"
  },
  {
   "start": 43.84,
   "end": 45.52,
   "text": " To weź niech wbije i wpisz swój nick konta"
  },
  {
   "start": 45.52,
   "end": 46.2,
   "text": " Piąta, stack"
  },
  {
   "start": 46.2,
   "end": 47.6,
   "text": " Stworzona przez Gary'ego Tana"
  },
  {
   "start": 47.6,
   "end": 49.76,
   "text": " A i tak by the way, jeśli chcesz te wszystkie skille"
  },
  {
   "start": 49.76,
   "end": 51.9,
   "text": " To weź niech wbije i wpisz programista, a je dostaniesz"
  },
  {
   "start": 51.9,
   "end": 54.0,
   "text": " Daj ci 23 umiejętności w jednej wtyczce"
  },
  {
   "start": 54.0,
   "end": 58.76,
   "text": " Klauto ceni projekt z perspektywy prezesa, kierownik zespołu programistów, menadżerę i kontrolę jakości."
  },
  {
   "start": 58.8,
   "end": 59.6,
   "text": " Wszystko działa razem."
  }
 ],
