{
 "segments": [
  {
   "start": 0.0,
   "end": 2.94,
   "text": " Jak w 5 minut zamienić Claude Code w zespół 6 programistów?"
  },
  {
   "start": 2.98,
   "end": 6.52,
   "text": " Pierwsza wtyczka, Superpowers. 127 tysięcy gwiazdek na Githubie."
  },
  {
   "start": 6.58,
   "end": 11.6,
   "text": " Claude przestaje od razu zrzucać się na pisanie kodu, zaczyna planować, pisać teksty i sprawdzać własną pracę."
  },
  {
   "start": 11.64,
   "end": 13.8,
   "text": " Druga wtyczka, może już Tobie znana, Frontend Design."
  },
  {
   "start": 14.24,
   "end": 17.24,
   "text": " 277 tysięcy gwiazdek na Githubie, stworzona przez Anthropic."
  },
  {
   "start": 17.32,
   "end": 21.54,
   "text": " Eliminuje typowy wygląd stron przez AI, tworzy profesjonalne interfejsy gotowe do wdrożenia."
  },
  {
   "start": 21.7,
   "end": 22.62,
   "text": " Trzecia, Code Review."
  },
  {
   "start": 22.88,
   "end": 26.06,
   "text": " 5 agentów pracuje równolegle, każdy sprawdza Twój kod z innej strony."
  },
  {
   "start": 26.24,
   "end": 28.24,
   "text": " Błędy w kodzie, historia zmian, wszystko na raz."
  },
  {
   "start": 28.26,
   "end": 29.5,
   "text": " Czwarta, Security Review."
  },
  {
   "start": 29.5,
   "end": 34.48,
   "text": " Przeszukuje cały twój kod, tak aby nikt nie skracił kluczy w API i abyś był bezpieczny zanim cokolwiek opublikuje"
  },
  {
   "start": 34.48,
   "end": 35.52,
   "text": " Piąta, najlepsza"
  },
  {
   "start": 35.52,
   "end": 36.88,
   "text": " Zaraz ci powiem, ale najpierw"
  },
  {
   "start": 36.88,
   "end": 39.68,
   "text": " Jeśli chcesz pełną, dokładną analizę twojego całego profilu"
  },
  {
   "start": 39.68,
   "end": 42.86,
   "text": " Chcesz wiedzieć co cię blokuje i chcesz gotowe, wiralowe filmiki do nagrywania"
  },
  {
   "start": 42.86,
   "end": 43.84,
   "text": " Zupełnie za darmo"
  },
  {
   "start": 43.84,
   "end": 45.52,
   "text": " To weź niech wbije i wpisz swój nick konta"
  },
  {
   "start": 45.52,
   "end": 46.2,
   "text": " Piąta, stack"
  },
  {
   "start": 46.2,
   "end": 47.6,
   "text": " Stworzona przez Gary'ego Tana"
  },
  {
   "start": 47.6,
   "end": 49.76,
   "text": " A i tak by the way, jeśli chcesz te wszystkie skille"
  },
  {
   "start": 49.76,
   "end": 51.9,
   "text": " To weź niech wbije i wpisz programista, a je dostaniesz"
  },
  {
   "start": 51.9,
   "end": 54.0,
   "text": " Daj ci 23 umiejętności w jednej wtyczce"
  },
  {
   "start": 54.0,
   "end": 58.76,
   "text": " Klauto ceni projekt z perspektywy prezesa, kierownik zespołu programistów, menadżerę i kontrolę jakości."
  },
  {
   "start": 58.8,
   "end": 59.6,
   "text": " Wszystko działa razem."
  }
 ],
